{
  "version": 2,
  "buildCommand": "bash ./build-and-package.sh",
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "functions": {
    "api/handler.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/handler"
    }
  ]
}
