{
  "version": 2,
  "builds": [
    {
      "src": "api/handler.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/handler.js"
    }
  ],
  "buildCommand": "node ./build-vercel.mjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile"
}
