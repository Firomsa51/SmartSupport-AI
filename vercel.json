{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/smartsupport run build",
  "outputDirectory": "artifacts/smartsupport/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
